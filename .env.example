# --- Elasticsearch (Elastic Cloud Serverless project endpoint + API key) ---
HG_ES_URL=http://localhost:9200
HG_ES_API_KEY=
# Prefix for every index, so several deployments can share one project
HG_INDEX_PREFIX=hg-

# --- Mistral ---
HG_MISTRAL_API_KEY=
# Model aliases are checked against GET /v1/models at startup; override if your account uses other IDs
HG_MODEL_LARGE=mistral-large-latest
HG_MODEL_SMALL=mistral-small-latest
HG_MODEL_EMBED=mistral-embed
HG_MODEL_OCR=mistral-ocr-latest
HG_MODEL_MODERATION=mistral-moderation-latest
HG_MODEL_TRANSCRIBE=voxtral-mini-latest
HG_MODEL_TTS=voxtral-tts-latest

# --- Public URL of the web service (used in alert links and Telegram webhook) ---
HG_BASE_URL=http://localhost:8000

# --- Alerts ---
# Fernet key for encrypting phone numbers / chat ids at rest:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HG_FERNET_KEY=
# Photon iMessage (same project as the NightHacks app)
HG_PHOTON_PROJECT_ID=
HG_PHOTON_API_KEY=
# Telegram bot from @BotFather
HG_TELEGRAM_BOT_TOKEN=
HG_TELEGRAM_WEBHOOK_SECRET=
# Optional: Telegram chat id that receives ops alerts (stale feeds, dead letters)
HG_ADMIN_TELEGRAM_CHAT_ID=
# Web Push (VAPID):  python -m highground.messaging.webpush --generate
HG_VAPID_PUBLIC_KEY=
HG_VAPID_PRIVATE_KEY=
HG_VAPID_SUBJECT=mailto:you@example.com

# --- SF311 Open311 POST (request a key at https://mobile311.sfgov.org/open311) ---
HG_OPEN311_API_KEY=

# --- Apify ---
HG_APIFY_TOKEN=
HG_APIFY_MAX_USD_PER_RUN=2
HG_APIFY_WEBHOOK_SECRET=
